{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookmarkCraftsman",
  "version": "0.1.0",
  "identifier": "com.shuqianjiang.bookmarkcraftsman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "书签匠",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#f1eef7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "nsis/installer-icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "uninstallerHeaderImage": "nsis/header.bmp",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
